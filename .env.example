# --- WhatsApp Cloud API (todas obligatorias) ---------------------------------
# Token que vos elegís; se carga igual en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: con él se verifica la firma de cada webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API; usar la vigente según la documentación de Meta (no se fija en el código).
WHATSAPP_API_VERSION=

# --- Preguntas frecuentes ------------------------------------------------------
# Archivo JSON con las preguntas reales del club. El de ejemplo contiene datos FICTICIOS.
FAQ_PATH=data/faq.example.json

# --- Derivación a una persona (opcionales) ------------------------------------
# Si se define, se le avisa a este número (formato internacional, sin +) cada consulta derivada.
OPERATOR_WA_ID=
# Si se define, se le envía al socio este texto cuando su consulta se deriva.
# Si queda vacío, el socio no recibe nada automático.
HANDOFF_ACK=

# --- Umbrales y límites (los valores por defecto están pensados para EMBEDDER=minilm) ---
# CONFIDENCE_THRESHOLD=0.8
# CACHE_THRESHOLD=0.95
# CACHE_TTL_SECONDS=21600
# CACHE_MAX_ENTRIES=1000
# RATE_LIMIT_PER_MINUTE=10

# --- Embeddings: tfidf (sin descargas) | minilm (requirements-minilm.txt) ------
# EMBEDDER=tfidf
# EMBEDDER_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- LLM opcional: redactar la respuesta a partir del FAQ recuperado ---------------
# LLM_MODEL=<identificador del modelo>
# ANTHROPIC_API_KEY=
